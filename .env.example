# Copy to .env and fill. NEVER commit .env.
# Set spend limits on each provider dashboard where available.

# --- Images: cutouts / scenes (provider-agnostic, see factory/router.py) ---
WAVESPEED_API_KEY=
KIE_API_KEY=
FAL_API_KEY=

# --- Images: consistent characters ---
MAGNIFIC_API_KEY=

# --- Real photos from the web ---
APIFY_API_TOKEN=
APIFY_IMAGE_ACTOR=hooli~google-images-scraper

# --- Voice + music ---
ELEVENLABS_API_KEY=

# --- Guardrails ---
MAX_SPEND_PER_RUN_USD=1.50
RENDER_CONCURRENCY=1

# --- Local Whisper (word-level subtitle alignment, factory/align.py) ---
# Free either way — no API, no cost. Bigger = more accurate, slower on CPU.
# tiny/base/small/medium/large-v3. Default: medium.
WHISPER_MODEL_SIZE=medium

# --- Optional LLM-written hooks/caption (factory/providers/text_llm.py) ---
# Off by default: factory.hooks / factory.caption use free mechanical
# templates unless ENABLE_LLM_COPY=true AND at least one key below is set.
# Real cost, but tiny (~$0.0002 per video at mistral-small-latest pricing).
# Only Mistral is actually wired in code today (endpoint/price verified in
# factory/providers/text_llm.py). Gemini/OpenAI/Anthropic are reserved slots
# — paste a key when you have one, but ask for the real provider class to be
# added before flipping ENABLE_LLM_COPY on with one of those (unverified
# endpoints don't get invented here).
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ENABLE_LLM_COPY=false
